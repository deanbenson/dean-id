{
	"name": "dean-id",
	"main": "index.js",
	"compatibility_date": "2026-06-12",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/demos/gr-estates/property.html"
		]
	},
	"routes": [
		{
			"pattern": "dean.id",
			"custom_domain": true
		},
		{
			"pattern": "www.dean.id",
			"custom_domain": true
		},
		{
			"pattern": "mta-sts.dean.id",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "LISTINGS",
			"id": "492530c137e74ce48deb278e249dc40f"
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *",
			"*/15 * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "gr_estates",
			"database_name": "gr-estates",
			"database_id": "bc51d668-d132-4ce5-aea0-c33b065d2ac2"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "RECORDINGS",
			"bucket_name": "gr-estates-recordings"
		},
		{
			"bucket_name": "gr-estates-recordings",
			"binding": "gr_estates_recordings"
		}
	],
	"vars": {
		"RIGHTMOVE_NETWORK_ID": "14258",
		"RIGHTMOVE_BRANCH_IDS": "217556",
		"RIGHTMOVE_RTDF_BASE": "https://adfapi.adftest.rightmove.com"
	},
	"mtls_certificates": [
		{
			"binding": "RIGHTMOVE_RTDF",
			"certificate_id": "f79ae5fe-8b27-4088-835a-00432cfa307d"
		}
	]
}
